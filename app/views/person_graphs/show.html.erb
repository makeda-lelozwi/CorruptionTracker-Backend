<section
  data-controller="person-graph"
  data-person-graph-url-value="<%= person_graph_data_path %>"
  data-person-graph-people-url-value="<%= person_graph_people_path %>"
>
  <label for="person-graph-person">Person</label>
  <select
    id="person-graph-person"
    data-person-graph-target="personSelect"
    data-action="change->person-graph#changePerson"
  ></select>

  <div
    class="graph-container"
    data-person-graph-target="canvas"
  ></div>

  <p
    class="graph-summary"
    data-person-graph-target="summary"
  ></p>
</section>
