<section class="facts facts--connections testimony-discussed-points" aria-labelledby="discussed-nodes-heading" data-controller="testimony-details">
  <h2 id="discussed-nodes-heading">Discussed points</h2>

  <% if facts.any? %>
    <ul class="testimony-discussed-nodes">
      <% facts.each do |fact| %>
        <li>
          <%= link_to fact[:target][:name], fact[:target][:path] %>
          <% if fact[:details].present? %>
            <p>
              - <%= truncate(fact[:details], length: 180, omission: "…") %>
              <button
                type="button"
                class="testimony-discussed-points__more"
                data-action="testimony-details#open"
                data-title="<%= fact[:target][:name] %>"
                data-details="<%= fact[:details] %>"
              >
                Read more
              </button>
            </p>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="empty-state">No public nodes are currently listed for this testimony.</p>
  <% end %>

  <dialog class="testimony-details__dialog" data-testimony-details-target="dialog" data-action="click->testimony-details#closeOnBackdrop">
    <header>
      <h2 data-testimony-details-target="title"></h2>
      <button type="button" aria-label="Close" data-action="testimony-details#close">×</button>
    </header>
    <p data-testimony-details-target="details"></p>
  </dialog>
</section>
