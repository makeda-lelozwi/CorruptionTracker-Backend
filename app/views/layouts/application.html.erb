<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Corruption Tracker" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Corruption Tracker">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= "home-page" if controller_name == "home" %>">
    <header class="site-header" data-controller="spotlight-search" data-action="keydown.esc@window->spotlight-search#close">
      <div class="site-header__inner">
        <%= link_to "Corruption Tracker", root_path, class: "site-header__brand" %>
        <a
          href="#spotlight-search-modal"
          class="site-search-toggle"
          aria-label="Open search"
          aria-haspopup="dialog"
          aria-controls="spotlight-search-modal"
          data-action="spotlight-search#open"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="6.5"></circle>
            <path d="m16 16 4 4"></path>
          </svg>
        </a>
        <%= form_with url: root_path, method: :get, class: "site-search" do |form| %>
          <%= form.search_field :q, value: params[:q], placeholder: "Search", aria: { label: "Search the corruption tracker" } %>
        <% end %>
        <nav class="site-nav" aria-label="Main navigation">
          <%= link_to "Home", root_path, aria: ({ current: "page" } if current_page?(root_path)) %>
          <%= link_to "About", about_path, aria: ({ current: "page" } if current_page?(about_path)) %>
        </nav>
      </div>

      <nav class="mobile-nav" aria-label="Mobile navigation">
        <%= link_to "Home", root_path, aria: ({ current: "page" } if current_page?(root_path)) %>
        <%= link_to "About", about_path, aria: ({ current: "page" } if current_page?(about_path)) %>
      </nav>

      <div
        id="spotlight-search-modal"
        class="spotlight-search"
        role="dialog"
        aria-labelledby="spotlight-search-heading"
        data-spotlight-search-target="dialog"
        data-action="click->spotlight-search#closeOnBackdrop"
      >
        <div class="spotlight-search__panel">
          <div class="spotlight-search__heading">
            <div>
              <p class="dashboard-panel__label">Search the network</p>
              <h2 id="spotlight-search-heading">Find a public record</h2>
            </div>
            <a href="#" class="spotlight-search__close" aria-label="Close search" data-action="spotlight-search#close">×</a>
          </div>

          <%= form_with url: root_path, method: :get, class: "spotlight-search__form" do |form| %>
            <%= form.label :q, "Search people, organisations, events and allegations", class: "visually-hidden" %>
            <%= form.search_field :q,
              value: params[:q],
              placeholder: "Type a name, event or allegation…",
              autocomplete: "off",
              data: { spotlight_search_target: "input" } %>
            <%= form.submit "Search" %>
          <% end %>
          <p class="spotlight-search__hint">Search across the public evidence index.</p>
        </div>
      </div>
    </header>
    <main class="site-main">
      <%= yield %>
    </main>
  </body>
</html>
