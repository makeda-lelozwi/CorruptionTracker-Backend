<% content_for :title, "Corruption Tracker" %>

<% if @load_error %>
  <p class="notice notice--error home-notice">The evidence web is temporarily unavailable. Please try again later.</p>
<% else %>
  <% if @latest_testimony %>
    <div class="home-dashboard">
      <section class="latest-testimony" aria-labelledby="latest-testimony-heading">
        <h1 id="latest-testimony-heading">Latest testimony hearing</h1>
        <dl class="latest-testimony__details">
          <div>
            <dt>Hearing</dt>
            <dd><%= testimony_heading(@latest_testimony) %></dd>
          </div>
          <div>
            <dt>Witness</dt>
            <dd><%= @latest_testimony["witness"] %></dd>
          </div>
        </dl>

        <% if @latest_testimony["allegations"].any? %>
          <div class="latest-testimony__topics">
            <h2><%= @latest_testimony.fetch("title").to_s[/Day\s+\d+/i] || "This testimony" %> discusses</h2>
            <ul>
              <% @latest_testimony["allegations"].each do |allegation| %>
                <li>allegations of “<%= allegation.fetch("name") %>”</li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= link_to "read more >", @latest_testimony.fetch("path"), class: "latest-testimony__link" %>
      </section>

      <aside class="home-overview" aria-labelledby="home-overview-heading">
        <section class="dashboard-panel dashboard-panel--accent">
          <p class="dashboard-panel__label">At a glance</p>
          <h2 id="home-overview-heading">Public records</h2>
          <strong class="dashboard-stat"><%= @sections.sum { |section| section[:count] } %></strong>
          <p>records across <%= pluralize(@sections.count, "index") %></p>
        </section>

        <section class="dashboard-panel">
          <p class="dashboard-panel__label">Start exploring</p>
          <h2>Browse by type</h2>
          <nav class="dashboard-links" aria-label="Evidence indexes">
            <% @sections.each do |section| %>
              <%= link_to PublicEntityCatalog.index_path(section[:entry].label) do %>
                <span><%= section[:entry].plural %></span>
                <span><%= section[:count] %></span>
              <% end %>
            <% end %>
          </nav>
        </section>
      </aside>
    </div>
  <% end %>

  <section class="home-index" id="index" aria-labelledby="index-heading">
    <div class="home-index__heading">
      <div>
        <p class="home-eyebrow">Explore the network</p>
        <h2 id="index-heading">Evidence index</h2>
      </div>
      <% if @query.present? %>
        <p class="home-index__summary">Results matching “<%= @query %>”.</p>
      <% else %>
        <p class="home-index__summary">Choose a record to follow its documented relationships.</p>
      <% end %>
    </div>

    <div class="home-index__grid">
      <% @sections.each do |section| %>
        <section class="home-index__section" aria-labelledby="<%= section[:entry].label.parameterize %>-heading">
          <div class="home-index__section-heading">
            <h3 id="<%= section[:entry].label.parameterize %>-heading">
              <%= link_to section[:entry].plural, PublicEntityCatalog.index_path(section[:entry].label) %>
            </h3>
            <span><%= section[:count] %></span>
          </div>

          <% if section[:entities].any? %>
            <ul>
              <% section[:entities].first(5).each do |entity| %>
                <li><%= link_to entity.fetch("name"), entity.fetch("path") %></li>
              <% end %>
            </ul>

            <% if section[:entities].length > 5 %>
              <details class="home-index__more">
                <summary>
                  <span class="home-index__more-label">show more &gt;</span>
                  <span class="home-index__less-label">show less &gt;</span>
                </summary>
                <ul>
                  <% section[:entities].drop(5).each do |entity| %>
                    <li><%= link_to entity.fetch("name"), entity.fetch("path") %></li>
                  <% end %>
                </ul>
              </details>
            <% end %>
          <% else %>
            <p class="home-index__empty">No <%= section[:entry].plural.downcase %><%= " matched this search" if @query.present? %>.</p>
          <% end %>

          <%= link_to "Browse all →", PublicEntityCatalog.index_path(section[:entry].label), class: "home-index__browse" %>
        </section>
      <% end %>
    </div>
  </section>
<% end %>
